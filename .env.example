# Resend (https://resend.com/api-keys) — server-only, never expose to the client.
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Resend sender ("from" address). Use a domain you control once verified,
# or "onboarding@resend.dev" while testing.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=you@example.com

# Optional local-only API mock for UI testing in `npm run dev` or `npm run preview`.
# Use: true, success, validation, send_failed, rate_limited, false
CONTACT_API_MOCK=false
